# Group id of the docker group on this host: getent group docker | cut -d: -f3
DOCKER_GID=999

# Filesystem to report as DISK. Use your data disk if / is read-only or tiny
# (for example /var/home on Fedora Atomic desktops).
HOST_DISK_PATH=/

# Address and port for /host.json. Bind to one LAN address to keep it off other interfaces.
STATS_BIND=0.0.0.0
STATS_PORT=8766
